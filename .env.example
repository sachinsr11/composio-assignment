# Copy to .env and fill in. Never commit .env.
COMPOSIO_API_KEY=your_composio_api_key
GOOGLE_API_KEY=your_google_gemini_api_key
# Optional overrides
GEMINI_MODEL=gemini-3.5-flash-lite
# On repeated 503 "high demand" from the preferred model, try these in order.
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.6-flash,gemini-3.1-flash-lite
# Optional: pin gather tool slugs if runtime discovery is unavailable.
# COMPOSIO_SEARCH_SLUG=
# COMPOSIO_SCRAPE_SLUG=
